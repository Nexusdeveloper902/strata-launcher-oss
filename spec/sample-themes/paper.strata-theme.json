    "date": { "visible": true, "skeleton": "EEEEdMMMM", "sizeSp": 16 }
  },
  "favorites": { "textScale": 1.4, "alignment": "start", "verticalPosition": "bottom", "showIcons": false },
  "search": { "position": "bottom", "style": "underline", "showHint": true },
  "alphabetIndex": { "visibility": "listOnly", "side": "end", "glyphs": "letters", "textSizeSp": 12 },
  "animation": { "durationScale": 1.0, "listEntrance": "fade" },
  "haptics": { "mode": "followSystem" }

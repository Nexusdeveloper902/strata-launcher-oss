{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strata-launcher.invalid/schema/theme/1.0/theme.schema.json",
  "title": "Strata Launcher theme, schemaVersion 1 (minor 0)",
  "description": "Strict schema for .strata-theme.json files (spec/THEME_SYSTEM.md). Only schemaVersion, id and name are required; every omitted field takes its documented default. Keys starting with 'x-' are allowed on every object and preserved. The app's importer runs this schema in lenient mode (spec/THEME_SYSTEM.md §8): unknown non-'x-' keys become warnings and are preserved instead of failing validation.",
  "type": "object",
  "required": ["schemaVersion", "id", "name"],
  "properties": {
    "$schema": { "type": "string", "maxLength": 512, "description": "Optional editor hint. Never fetched by the app." },
    "schemaVersion": { "type": "integer", "const": 1, "description": "Major schema version. A higher value is rejected by this app version." },
    "schemaMinor": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 0, "description": "Additive minor revision. Higher-than-known minors import with unknown keys preserved." },
    "id": { "$ref": "#/$defs/uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 64, "description": "1-64 grapheme clusters, no control characters. JSON Schema counts code points, so the grapheme limit and the control-character rule are enforced by the app (spec/THEME_SYSTEM.md §4.1); this maxLength is only an outer bound." },
    "author": { "type": "string", "maxLength": 64, "description": "At most 64 grapheme clusters, no control characters (app-enforced, spec §4.1)." },
    "description": { "type": "string", "maxLength": 500, "description": "At most 500 grapheme clusters, no control characters except line feed (app-enforced, spec §4.1)." },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "modifiedAt": { "$ref": "#/$defs/timestamp" },
    "basedOn": { "$ref": "#/$defs/uuid", "description": "id of the theme this one was duplicated from (informational)." },
    "colors": { "$ref": "#/$defs/colors" },
    "wallpaper": { "$ref": "#/$defs/wallpaper" },
    "typography": { "$ref": "#/$defs/typography" },
    "list": { "$ref": "#/$defs/list" },
    "icons": { "$ref": "#/$defs/icons" },
    "clock": { "$ref": "#/$defs/clock" },
    "favorites": { "$ref": "#/$defs/favorites" },
    "search": { "$ref": "#/$defs/search" },
    "alphabetIndex": { "$ref": "#/$defs/alphabetIndex" },
    "animation": { "$ref": "#/$defs/animation" },
    "haptics": { "$ref": "#/$defs/haptics" }
  },
  "patternProperties": { "^x-[a-z0-9][a-z0-9._-]{0,62}$": { "$ref": "#/$defs/extensionValue" } },
  "additionalProperties": false,

  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "timestamp": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "description": "Opaque sRGB colour #RRGGBB. Transparency is expressed only through wallpaper.dim and wallpaper.backgroundOpacity."
    },
    "packageName": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
    },
    "extensionValue": {
      "description": "Opaque extension data. Size/depth limits of spec §9 still apply.",
      "type": ["object", "array", "string", "number", "integer", "boolean", "null"]
    },
    "palette": {
      "type": "object",
      "description": "Colour roles. Omitted roles fall back to the built-in default palette of the same variant.",
      "properties": {
        "background": { "$ref": "#/$defs/color" },
        "surface": { "$ref": "#/$defs/color" },
        "textPrimary": { "$ref": "#/$defs/color", "description": "onBackground role: app labels, clock, favourites." },
        "textSecondary": { "$ref": "#/$defs/color", "description": "onBackground muted role: date, section letters, hints." },
        "accent": { "$ref": "#/$defs/color" },
        "onAccent": { "$ref": "#/$defs/color" },
        "divider": { "$ref": "#/$defs/color" },
        "highlight": { "$ref": "#/$defs/color", "description": "Opaque row background for pressed/selected/focused items." },
        "scrim": { "$ref": "#/$defs/color", "description": "Colour laid over the wallpaper at alpha wallpaper.dim." }
      },
      "patternProperties": { "^x-[a-z0-9][a-z0-9._-]{0,62}$": { "$ref": "#/$defs/extensionValue" } },
      "additionalProperties": false
    },
    "colorRole": {
      "enum": ["background", "surface", "textPrimary", "textSecondary", "accent", "onAccent", "divider", "highlight", "scrim"]
    },
    "colors": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["system", "light", "dark", "wallpaper"], "default": "system" },
        "source": {
          "type": "object",
          "properties": {
            "kind": { "enum": ["fixed", "seed", "wallpaper", "dynamic"], "default": "fixed" },
            "seedColor": { "$ref": "#/$defs/color" },
            "lockedRoles": {
              "type": "array",
              "items": { "$ref": "#/$defs/colorRole" },
              "uniqueItems": true,
              "maxItems": 9,
              "default": []
            }
          },
          "patternProperties": { "^x-[a-z0-9][a-z0-9._-]{0,62}$": { "$ref": "#/$defs/extensionValue" } },
          "additionalProperties": false
        },
        "pureBlack": { "type": "boolean", "default": false },
        "light": { "$ref": "#/$defs/palette" },
        "dark": { "$ref": "#/$defs/palette" }
      },
      "patternProperties": { "^x-[a-z0-9][a-z0-9._-]{0,62}$": { "$ref": "#/$defs/extensionValue" } },
      "additionalProperties": false
    },
    "wallpaper": {
      "type": "object",
      "properties": {
        "show": { "type": "boolean", "default": false },
        "dim": { "type": "number", "minimum": 0, "maximum": 0.95, "default": 0.5 },
        "backgroundOpacity": { "type": "number", "minimum": 0, "maximum": 1, "default": 0 },
        "image": {
          "type": "object",
          "description": "Optional wallpaper shipped in a .strata-theme.zip bundle. Never applied without explicit user confirmation.",
          "required": ["sha256"],
          "properties": {
            "sha256": { "$ref": "#/$defs/sha256" },
            "mediaType": { "enum": ["image/png", "image/jpeg", "image/webp"] }
          },
          "patternProperties": { "^x-[a-z0-9][a-z0-9._-]{0,62}$": { "$ref": "#/$defs/extensionValue" } },
          "additionalProperties": false
        }
      },
      "patternProperties": { "^x-[a-z0-9][a-z0-9._-]{0,62}$": { "$ref": "#/$defs/extensionValue" } },
      "additionalProperties": false
    },
    "fontRef": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["system", "bundled", "user"] },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$", "description": "Bundled font catalogue ID (kind=bundled)." },
        "sha256": { "$ref": "#/$defs/sha256", "description": "Content hash of a user font file (kind=user)." },
        "displayName": { "type": "string", "maxLength": 64 }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "bundled" } } }, "then": { "required": ["id"] } },
        { "if": { "properties": { "kind": { "const": "user" } } }, "then": { "required": ["sha256"] } }
      ],
      "patternProperties": { "^x-[a-z0-9][a-z0-9._-]{0,62}$": { "$ref": "#/$defs/extensionValue" } },
      "additionalProperties": false
    },
    "weight": { "type": "integer", "minimum": 100, "maximum": 900, "multipleOf": 100 },
    "typography": {
      "type": "object",
      "properties": {
        "family": { "$ref": "#/$defs/fontRef" },
        "clockFamily": { "$ref": "#/$defs/fontRef" },
        "scale": { "type": "number", "minimum": 0.8, "maximum": 1.5, "default": 1.0 },
        "labelWeight": { "$ref": "#/$defs/weight", "default": 400 },
        "headingWeight": { "$ref": "#/$defs/weight", "default": 500 },
        "clockWeight": { "$ref": "#/$defs/weight", "default": 300 },
        "letterSpacingEm": { "type": "number", "minimum": -0.05, "maximum": 0.2, "default": 0 },
        "labelCase": { "enum": ["asIs", "lower", "upper", "title"], "default": "asIs" },
        "smallTextUsesSystemFont": { "type": "boolean", "default": false }
      },
      "patternProperties": { "^x-[a-z0-9][a-z0-9._-]{0,62}$": { "$ref": "#/$defs/extensionValue" } },
      "additionalProperties": false
    },
    "list": {
      "type": "object",
      "properties": {
        "density": { "enum": ["compact", "comfortable", "spacious"], "default": "comfortable" },
        "rowHeightDp": { "type": "integer", "minimum": 48, "maximum": 96, "description": "Optional override of the density's row height." },
        "horizontalPaddingDp": { "type": "integer", "minimum": 0, "maximum": 48, "default": 16 },
        "itemSpacingDp": { "type": "integer", "minimum": 0, "maximum": 24, "default": 0 },
        "sectionHeaders": { "type": "boolean", "default": true },
        "showDividers": { "type": "boolean", "default": false }
      },
      "patternProperties": { "^x-[a-z0-9][a-z0-9._-]{0,62}$": { "$ref": "#/$defs/extensionValue" } },
      "additionalProperties": false
    },
    "icons": {
      "type": "object",
      "properties": {
        "visible": { "type": "boolean", "default": true },
        "sizeDp": { "type": "integer", "minimum": 20, "maximum": 64, "default": 32 },
        "shape": { "enum": ["system", "circle", "squircle", "roundedSquare", "square"], "default": "system" },
        "cornerRadiusPercent": { "type": "integer", "minimum": 0, "maximum": 50, "default": 25 },
        "pack": {
          "type": ["object", "null"],
          "default": null,
          "required": ["package"],
          "properties": {
            "package": { "$ref": "#/$defs/packageName" },
            "displayName": { "type": "string", "maxLength": 64 },
            "fallback": { "enum": ["system", "monochrome"], "default": "system" }
          },
          "patternProperties": { "^x-[a-z0-9][a-z0-9._-]{0,62}$": { "$ref": "#/$defs/extensionValue" } },
          "additionalProperties": false
        },
        "tint": { "enum": ["none", "monochrome", "accent"], "default": "none" },
        "legacyIconPlate": { "type": "boolean", "default": true, "description": "Place non-adaptive (legacy) icons on a surface-coloured plate in the chosen shape." },
        "labelsVisible": { "type": "boolean", "default": true }
      },
      "patternProperties": { "^x-[a-z0-9][a-z0-9._-]{0,62}$": { "$ref": "#/$defs/extensionValue" } },
      "additionalProperties": false
    },
    "clock": {
      "type": "object",
      "properties": {
        "visible": { "type": "boolean", "default": true },
        "style": { "enum": ["numeric", "numericStacked", "words", "analogMinimal"], "default": "numeric" },
        "hourFormat": { "enum": ["system", "h12", "h24"], "default": "system" },
        "showSeconds": { "type": "boolean", "default": false },
        "sizeSp": { "type": "integer", "minimum": 24, "maximum": 128, "default": 56 },
        "alignment": { "enum": ["start", "center", "end"], "default": "start" },
        "date": {
          "type": "object",
          "properties": {
            "visible": { "type": "boolean", "default": true },
            "skeleton": { "type": "string", "pattern": "^[yMLdEc]{1,16}$", "default": "EEEEdMMMM", "description": "CLDR date skeleton localised via DateFormat.getBestDateTimePattern." },
            "sizeSp": { "type": "integer", "minimum": 12, "maximum": 32, "default": 16 }
          },
          "patternProperties": { "^x-[a-z0-9][a-z0-9._-]{0,62}$": { "$ref": "#/$defs/extensionValue" } },
          "additionalProperties": false
        }
      },
      "patternProperties": { "^x-[a-z0-9][a-z0-9._-]{0,62}$": { "$ref": "#/$defs/extensionValue" } },
      "additionalProperties": false
    },
    "favorites": {
      "type": "object",
      "properties": {
        "textScale": { "type": "number", "minimum": 0.8, "maximum": 2.0, "default": 1.3 },
        "alignment": { "enum": ["start", "center", "end"], "default": "start" },
        "verticalPosition": { "enum": ["top", "center", "bottom"], "default": "bottom" },
        "showIcons": { "type": "boolean", "default": false },
        "showLabels": { "type": "boolean", "default": true },
        "spacingDp": { "type": "integer", "minimum": 0, "maximum": 32, "default": 8 }
      },
      "patternProperties": { "^x-[a-z0-9][a-z0-9._-]{0,62}$": { "$ref": "#/$defs/extensionValue" } },
      "additionalProperties": false
    },
    "search": {
      "type": "object",
      "properties": {
        "position": { "enum": ["top", "bottom", "hidden"], "default": "bottom" },
        "style": { "enum": ["pill", "box", "underline"], "default": "pill" },
        "cornerRadiusDp": { "type": "integer", "minimum": 0, "maximum": 28, "default": 24 },
        "showHint": { "type": "boolean", "default": true }
      },
      "patternProperties": { "^x-[a-z0-9][a-z0-9._-]{0,62}$": { "$ref": "#/$defs/extensionValue" } },
      "additionalProperties": false
    },
    "alphabetIndex": {
      "type": "object",
      "properties": {
        "visibility": { "enum": ["always", "listOnly", "never"], "default": "always" },
        "side": { "enum": ["end", "start"], "default": "end" },
        "glyphs": { "enum": ["letters", "dots"], "default": "letters" },
        "textSizeSp": { "type": "integer", "minimum": 10, "maximum": 18, "default": 12 },
        "showBubble": { "type": "boolean", "default": true }
      },
      "patternProperties": { "^x-[a-z0-9][a-z0-9._-]{0,62}$": { "$ref": "#/$defs/extensionValue" } },
      "additionalProperties": false
    },
    "animation": {
      "type": "object",
      "properties": {
        "durationScale": { "type": "number", "minimum": 0, "maximum": 2, "default": 1 },
        "listEntrance": { "enum": ["none", "fade", "slide"], "default": "fade" }
      },
      "patternProperties": { "^x-[a-z0-9][a-z0-9._-]{0,62}$": { "$ref": "#/$defs/extensionValue" } },
      "additionalProperties": false
    },
    "haptics": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["followSystem", "off"], "default": "followSystem" }
      },
      "patternProperties": { "^x-[a-z0-9][a-z0-9._-]{0,62}$": { "$ref": "#/$defs/extensionValue" } },
      "additionalProperties": false
    }
  }
}

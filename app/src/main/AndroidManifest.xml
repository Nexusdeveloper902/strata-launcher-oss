<?xml version="1.0" encoding="utf-8"?>
<!-- Strata Launcher. Skeleton: spec/ANDROID_PLATFORM.md §22 with the ARCHITECTURE §17 deltas.
     Components of §22 arrive with their milestones (M5: ThemeImportActivity, FileProvider; ThemesActivity is
     the non-exported theme library; M6: PinRequestActivity; M7: BadgeListenerService, WidgetHostRestoredReceiver,
     and the non-exported WidgetPickerActivity). Permissions = ANDROID_PLATFORM §23 Required + Optional (T-CI-01, T-PRIV-03). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required (normal-level, install-time) -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" /> <!-- used on API 35+ only -->

    <!-- Optional runtime permission, requested only when contact search is enabled (FR-SEARCH-06) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Strip AD_ID if any transitive dependency merges it in (NFR-PRIV-02) -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <!-- Not declared: INTERNET (NFR-PRIV-01), PACKAGE_USAGE_STATS (ARCHITECTURE §17), SET_WALLPAPER (D-009) -->

    <!-- Package visibility (instead of QUERY_ALL_PACKAGES) -->
    <queries>
        <intent> <!-- launchable apps -->
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent> <!-- other home apps (role/fallback checks) -->
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent> <!-- widget providers -->
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <intent> <!-- shortcut config activities -->
            <action android:name="android.intent.action.CREATE_SHORTCUT" />
        </intent>
        <intent> <!-- icon packs: ecosystem convention, not an Android API -->
            <action android:name="org.adw.ActivityStarter.THEMES" />
        </intent>
        <intent> <!-- store hand-off from search (FR-SEARCH-07): row shown only when a handler resolves -->
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application
        android:name=".StrataApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Strata"
        tools:targetApi="36">

        <!-- Home -->
        <activity
            android:name=".home.HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|mcc|mnc|navigation|orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|fontScale|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="unspecified"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Strata.Home"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Entry activity (D-008): the app icon in other launchers. MAIN/LAUNCHER → onboarding if
             not done, else explicit intent to HomeActivity; APPLICATION_PREFERENCES → settings. -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:taskAffinity="app.strata.launcher.settings">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Pin shortcut / pin widget confirmation (default launcher target, ANDROID_PLATFORM §6, §22). v1 declines
             every request (FR-APPS-08 pins are v1.x); a forged intent finishes at once (T-SEC-02). -->
        <activity
            android:name=".pin.PinRequestActivity"
            android:autoRemoveFromRecents="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.Strata.Dialog">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
                <action android:name="android.content.pm.action.CONFIRM_PIN_APPWIDGET" />
            </intent-filter>
        </activity>

        <!-- S-WPICK and the widget bind flow (FR-WIDGET-02, J-10), started from home. Not exported. BIND_APPWIDGET is
             never declared (ANDROID_PLATFORM §7, §23): binding is bindAppWidgetIdIfAllowed, then the user's consent. -->
        <activity
            android:name=".widget.WidgetPickerActivity"
            android:exported="false"
            android:label="@string/widget_picker_label"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- Widget-ID remap after restore (FR-WIDGET-04; protected system broadcast, ANDROID_PLATFORM §22). The
             receiver checks the action, our host ID and the extras (ARCHITECTURE §13). -->
        <receiver
            android:name=".widget.WidgetHostRestoredReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_HOST_RESTORED" />
            </intent-filter>
        </receiver>

        <!-- Optional: notification badges (FR-NOTIF-01). The system binds it only after the user grants listener access
             in the system settings; only the system can bind it (BIND_NOTIFICATION_LISTENER_SERVICE). Counts only,
             in memory (FR-NOTIF-03). Filter types apply on API 31+; older APIs filter in code. -->
        <service
            android:name=".badges.BadgeListenerService"
            android:exported="false"
            android:label="@string/badge_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting" />
            <meta-data
                android:name="android.service.notification.disabled_filter_types"
                android:value="ongoing|silent" />
        </service>

        <!-- Theme library (FR-THEME-27), opened from the home menu. Not exported. -->
        <activity
            android:name=".theme.ThemesActivity"
            android:exported="false"
            android:label="@string/themes_label"
            android:taskAffinity="app.strata.launcher.settings" />

        <!-- Theme editor (FR-THEME-29/30), started from the theme library. Not exported. Create-from-image uses the
             system photo picker, which needs no storage permission. -->
        <activity
            android:name=".theme.ThemeEditorActivity"
            android:exported="false"
            android:label="@string/theme_editor_label"
            android:taskAffinity="app.strata.launcher.settings"
            android:windowSoftInputMode="adjustResize" />

        <!-- S-ICON, the per-app icon chooser (FR-APPS-06), started from the options sheet. Not exported. -->
        <activity
            android:name=".theme.IconChooserActivity"
            android:exported="false"
            android:label="@string/icon_chooser_label"
            android:taskAffinity="app.strata.launcher.settings" />

        <!-- Theme import from other apps (FR-THEME-21). MIME list = THEME_SYSTEM §3.1 (canonical).
             VIEW carries the URI in getData, so the filter pins scheme="content".
             SEND carries it in EXTRA_STREAM (no data URI), so its filter has no scheme;
             the activity rejects any EXTRA_STREAM that is not content: (ARCHITECTURE §13). -->
        <activity
            android:name=".theme.ThemeImportActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/theme_import_label">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Share exported themes and hand theme wallpapers to the system via content:// URIs
             (FR-THEME-23, FR-THEME-34). Not exported; access only through per-URI grants (T-SEC-05). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" /> <!-- only <cache-path path="share/"/> -->
        </provider>
    </application>
</manifest>

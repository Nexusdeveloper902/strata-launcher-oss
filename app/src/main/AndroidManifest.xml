<?xml version="1.0" encoding="utf-8"?>
<!-- Strata Launcher. Skeleton: spec/ANDROID_PLATFORM.md §22 with the ARCHITECTURE §17 deltas.
     M0 declares only HomeActivity and SettingsActivity; the other components of §22 arrive with
     their milestones. Permissions = ANDROID_PLATFORM §23 Required + Optional (T-CI-01, T-PRIV-03). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required (normal-level, install-time) -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" /> <!-- used on API 35+ only -->

    <!-- Optional runtime permission, requested only when contact search is enabled (FR-SEARCH-06) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Strip AD_ID if any transitive dependency merges it in (NFR-PRIV-02) -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <!-- Not declared: INTERNET (NFR-PRIV-01), PACKAGE_USAGE_STATS (ARCHITECTURE §17), SET_WALLPAPER (D-009) -->

    <!-- Package visibility (instead of QUERY_ALL_PACKAGES) -->
    <queries>
        <intent> <!-- launchable apps -->
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent> <!-- other home apps (role/fallback checks) -->
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent> <!-- widget providers -->
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <intent> <!-- shortcut config activities -->
            <action android:name="android.intent.action.CREATE_SHORTCUT" />
        </intent>
        <intent> <!-- icon packs: ecosystem convention, not an Android API -->
            <action android:name="org.adw.ActivityStarter.THEMES" />
        </intent>
    </queries>

    <application
        android:name=".StrataApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Strata"
        tools:targetApi="36">

        <!-- Home -->
        <activity
            android:name=".home.HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|mcc|mnc|navigation|orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|fontScale|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="unspecified"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Strata.Home"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Entry activity (D-008): the app icon in other launchers. MAIN/LAUNCHER → onboarding if
             not done, else explicit intent to HomeActivity; APPLICATION_PREFERENCES → settings. -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:taskAffinity="app.strata.launcher.settings">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>

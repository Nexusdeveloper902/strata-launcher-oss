<?xml version="1.0" encoding="utf-8"?>
<!-- Test APK only: the WIDGET_FIX list (T-GEST-02 scrolls it) under a title that WidgetFixtureReceiver can update. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF202020"
    android:orientation="vertical">

    <TextView
        android:id="@+id/fixture_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="@string/fixture_widget_title"
        android:textColor="#FFFFFFFF" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/fixture_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/fixture_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/fixture_widget_empty"
            android:textColor="#FFFFFFFF" />
    </FrameLayout>
</LinearLayout>
